generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite"; url = "file:./dev.db" }
enum Plan { FREE STARTER PRO AGENCY }
model User { id String @id @default(cuid()) email String @unique emailVerifiedAt DateTime? passwordHash String? stripeCustomerId String? @unique plan Plan @default(FREE) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt providers OAuthProvider[] subscriptions Subscription? verifyTokens EmailVerifyToken[] oneTimeTokens OneTimeToken[] }
model OAuthProvider { id String @id @default(cuid()) userId String provider String providerId String accessToken String? refreshToken String? createdAt DateTime @default(now()) user User @relation(fields: [userId], references: [id]) @@unique([provider, providerId]) @@index([userId]) }
model EmailVerifyToken { id String @id @default(cuid()) userId String token String @unique expiresAt DateTime user User @relation(fields: [userId], references: [id]) @@index([userId]) }
model OneTimeToken { id String @id @default(cuid()) userId String token String @unique expiresAt DateTime consumed Boolean @default(false) user User @relation(fields: [userId], references: [id]) @@index([userId]) }
model Subscription { id String @id @default(cuid()) userId String @unique stripeSubId String @unique stripePriceId String status String currentPeriodEnd DateTime createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields: [userId], references: [id]) }
